# ==============================================================================
# Enterprise Python Automation - Configuration Settings
# ==============================================================================

# API Configuration
# Default is 'mock://enterprise-sales-api' for built-in enterprise mock server,
# or provide any custom REST API endpoint URL (e.g. https://api.mycompany.com/sales)
API_URL=mock://enterprise-sales-api
API_TIMEOUT=10
API_KEY=

# File System Directories
OUTPUT_DIRECTORY=reports
LOG_DIRECTORY=logs
CHART_DIRECTORY=charts
DATA_DIRECTORY=data

# Report Branding and Customization
COMPANY_NAME=Apex Enterprise Solutions Inc.
REPORT_TITLE=AUTOMATED BUSINESS PERFORMANCE REPORT
CURRENCY_SYMBOL=₹

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
